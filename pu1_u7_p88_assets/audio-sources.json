    "reference": "Teacher-provided recording, first 25 seconds; original reference kept outside repository"
  },
  {
    "clip": 1,
    "text": "Body Power",
    "source": "OpenRouter fish-audio/s2.1-pro-free:free; teacher reference audio",
    "bytes": 8589,
    "reference": "Teacher-provided recording, first 25 seconds; original reference kept outside repository"
  },
  {
    "clip": 7,
    "text": "Vitamin D comes from the sun.",
